{
  "name": "qswissknife",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/install.ps1",
    "icons": "python launcher/make-icons.py",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/build-exe.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/package.ps1"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "mediabunny": "^1.62.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.9.1",
    "turndown": "^7.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "author": "AnnoyingDoggo",
  "description": "QSwissKnife — convert, compress, crop and trim images, video, audio and PDFs on your own PC."
}
